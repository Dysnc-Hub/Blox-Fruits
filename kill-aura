local islandsSea1 = {
    "Pirate Starter",
    "Marine Starter",
    "Jungle",
    "Pirate Village",
    "Desert",
    "Snow Mountain",
    "Magma Village"
}

Tabs.Teleport:AddDropdown("Sea1TP", {
    Title = "Teleportar para Ilhas (Sea 1)",
