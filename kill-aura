-- SERVIÇOS E VARIÁVEIS GLOBAIS
--------------------------------------------------------------------------------
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local Net = require(ReplicatedStorage.Modules.Net)
local RegisterHitEvent = Net:RemoteEvent("RegisterHit", true)

--------------------------------------------------------------------------------
-- ABA 1: KILL AURA TURBO
--------------------------------------------------------------------------------
Tabs.Main:AddToggle("KillAuraTurbo", {
    Title = "Ativar Kill Aura Turbo",
    Default = false
})

Tabs.Main:AddSlider("AttackSpeed", {
    Title = "Velocidade do Ataque (Delay)",
    Description = "Menor = Mais rápido",
    Default = 0.15,
    Min = 0.05,
    Max = 0.5,
    Rounding = 2,
    Callback = function(Value)
    end
})

local function getClosestEnemy()
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end

    local closestTarget = nil
    local shortestDistance = 35 -- 35 Studs

    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
        local humanoidRootPart = enemy:FindFirstChild("HumanoidRootPart")
        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        
        if humanoidRootPart and humanoid and humanoid.Health > 0 and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (LocalPlayer.Character.HumanoidRootPart.Position - humanoidRootPart.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                closestTarget = enemy
            end
        end
    end

    return closestTarget
end

-- Loop de Ataque Turbo
task.spawn(function()
    while true do
        local delayTime = Options.AttackSpeed and Options.AttackSpeed.Value or 0.15
        task.wait(delayTime)
        
        if Options.KillAuraTurbo and Options.KillAuraTurbo.Value then
            local target = getClosestEnemy()
            if target then
                local targetPart = target:FindFirstChild("UpperTorso") or target:FindFirstChild("HumanoidRootPart")
                
                if targetPart and RegisterHitEvent then
                    pcall(function()
                        local netModule = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
                        if netModule then
                            local regAttack = netModule:FindFirstChild("RE/RegisterAttack")
                            if regAttack then
                                regAttack:FireServer(0.36666667461395264, 1)
                            end
                        end
                        RegisterHitEvent:FireServer(targetPart)
                    end)
                end
            end
        end
    end
end)

--------------------------------------------------------------------------------
-- ABA 2: AUTO FARM (Exemplo estrutural)
--------------------------------------------------------------------------------
Tabs.Farm:AddToggle("AutoFarmLevel", {
    Title = "Auto Farm Level (Mobs Próximos)",
    Default = false
})

task.spawn(function()
    while true do
        task.wait(0.5)
        if Options.AutoFarmLevel and Options.AutoFarmLevel.Value then
            pcall(function()
                local target = getClosestEnemy()
                if target and target:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    -- Puxa o player levemente acima/perto do mob para o Kill Aura pegar
                    local targetCFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 5, 3)
                    LocalPlayer.Character.HumanoidRootPart.CFrame = targetCFrame
                end
            end)
        end
    end
end)

